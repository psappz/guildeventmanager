package-as: GuildEventManager

move-folders:
  GuildEventManager/GuildEventManager_PvP: GuildEventManager_PvP
  GuildEventManager/GuildEventManager_PvE: GuildEventManager_PvE

manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - RELEASE_NOTES.md
  - tools
  - art-src
  - README.md
  - .github
  - docs
  - examples
